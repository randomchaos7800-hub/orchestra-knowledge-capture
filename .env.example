# Orchestra Knowledge Capture — configuration
# Copy to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────

# Path to your Orchestra wiki directory (where wiki/ lives)
WIKI_DIR=/path/to/your/orchestra

# LLM — any OpenAI-compatible endpoint
# Local inference (default — no API key required):
OPENAI_BASE_URL=http://127.0.0.1:8010/v1
OPENAI_API_KEY=not-required-for-local
OPENAI_MODEL=qwen2.5-72b-instruct

# OpenRouter (cloud fallback — needs API key):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=google/gemini-2.0-flash-001

# ── Optional ──────────────────────────────────────────────────────────────────

# Separate model for Q&A (uses OPENAI_MODEL if not set)
# QA_MODEL=qwen2.5-72b-instruct

# Per-pass model overrides (both default to OPENAI_MODEL)
# PLAN_MODEL=qwen2.5-7b-instruct    # Pass 1: JSON planning (cheaper/faster)
# WRITE_MODEL=qwen2.5-72b-instruct  # Pass 2: article writing (more capable)

# Server
PORT=8080
HOST=0.0.0.0

# Knowledge base display name (shown in UI)
KB_NAME=Knowledge Base
